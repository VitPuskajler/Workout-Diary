/* --------------------------------------------------------------------------
   headings.css - one typographic treatment for every heading in the app.

   No webfont: this is the system stack the rest of the app already uses, made
   to look deliberate with case, tracking and weight alone. Nothing to
   download, nothing to go stale, and no second request on a host that already
   stalls.

   Tracking scales DOWN as the type scales up, which is the actual rule -
   letter-spacing that reads as elegant at 1rem reads as broken at 2.5rem.

   Bootstrap's .h1-.h3 classes are matched as well as the tags, because
   several page titles in this app are <p class="h2"> rather than a real
   heading element.
-------------------------------------------------------------------------- */
h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6 {
  text-transform: uppercase;
  font-weight: 500;
}

h1, .h1 { letter-spacing: 0.06em; }
h2, .h2 { letter-spacing: 0.08em; }
h3, .h3 { letter-spacing: 0.10em; }

/* h4 down are section labels rather than page titles - the green workout-day
   names, the card headings on the home page. One tracking for all three: the
   size difference between them is too small to be worth three values. */
h4, h5, h6,
.h4, .h5, .h6 { letter-spacing: 0.12em; }

/* Dialog titles are sentences, not signage. Left alone on purpose. */
.modal-title {
  text-transform: none;
  letter-spacing: normal;
}

/* A quiet section label: small, widely tracked, muted. For a heading that
   names a region of the page rather than the page itself - "Menu".
   padding-left cancels the trailing gap letter-spacing leaves after the last
   letter, which otherwise pushes centred text half a space to the left. */
.wd-label {
  font-size: 1.05rem;
  font-weight: 500;
  letter-spacing: 0.35em;
  color: var(--bs-secondary-color, #6c757d);
  padding-left: 0.35em;
}
